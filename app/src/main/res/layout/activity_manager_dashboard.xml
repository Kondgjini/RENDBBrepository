<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Preferences Gear -->
    <ImageButton
        android:id="@+id/preferencesGear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/preferences"
        android:src="@drawable/ic_settings" />

    <!-- Buttons -->
    <Button
        android:id="@+id/addPropertyButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_property" />

    <Button
        android:id="@+id/manageBookingsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/manage_bookings" />

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/propertiesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp" />
</LinearLayout>