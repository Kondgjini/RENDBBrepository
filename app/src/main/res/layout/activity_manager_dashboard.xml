<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageButton
        android:id="@+id/preferencesGear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@android:drawable/ic_menu_preferences"
        android:layout_gravity="end"
        android:contentDescription="Preferences" />

    <Button
        android:id="@+id/addPropertyButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Property" />

    <Button
        android:id="@+id/manageBookingsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Bookings"
        android:layout_marginTop="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/propertiesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/clearDatabaseButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clear Database"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:layout_marginTop="16dp"/>

</LinearLayout>