<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.rendbb">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RENDBB">

        <activity
            android:name=".views.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".views.LoginActivity"
            android:label="Login"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".views.RegisterActivity"
            android:label="Register"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".views.ManagerDashboardActivity"
            android:label="Dashboard" />

        <activity
            android:name=".views.AddPropertyActivity"
            android:label="Add Property" />

        <activity
            android:name=".views.PropertyDetailsActivity"
            android:label="Property Details" />

        <activity
            android:name=".views.EditPropertyActivity"
            android:label="Edit Property" />

        <activity
            android:name=".views.ManageBookingsActivity"
            android:label="Manage Bookings" />

        <activity
            android:name=".views.AddBookingActivity"
            android:label="Add Booking" />

        <activity
            android:name=".views.PropertyManagementActivity"
            android:label="Property Management" />

        <activity
            android:name=".views.PreferencesActivity"
            android:label="Preferences" />
    </application>
</manifest>